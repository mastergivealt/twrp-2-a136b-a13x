DEVICE_PATH := device/samsung/a13x
-include $(DEVICE_PATH)/generated.mk

# ---- Arch (Dimensity 700 / MT6833) ----
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic
# 64-bit only recovery: tell the build system explicitly (otherwise it assumes zygote32 and errors)
TARGET_SUPPORTS_64_BIT_APPS := true

TARGET_BOARD_PLATFORM := $(or $(GEN_PLATFORM),mt6833)
TARGET_BOOTLOADER_BOARD_NAME := $(or $(GEN_BOARD),mt6833)
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true

# ---- Kernel / boot image: everything below comes from the STOCK recovery.img ----
TARGET_NO_KERNEL := false
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
BOARD_KERNEL_CMDLINE := $(GEN_CMDLINE)
BOARD_BOOTIMG_HEADER_VERSION := $(GEN_HEADER_VERSION)
BOARD_KERNEL_BASE := $(GEN_BASE)
BOARD_KERNEL_PAGESIZE := $(GEN_PAGESIZE)
BOARD_KERNEL_OFFSET := $(GEN_KERNEL_OFFSET)
BOARD_RAMDISK_OFFSET := $(GEN_RAMDISK_OFFSET)
BOARD_KERNEL_TAGS_OFFSET := $(GEN_TAGS_OFFSET)
BOARD_SECOND_OFFSET := $(GEN_SECOND_OFFSET)
ifeq ($(GEN_HAS_DTB),true)
BOARD_DTB_OFFSET := $(GEN_DTB_OFFSET)
BOARD_MKBOOTIMG_ARGS += --dtb $(DEVICE_PATH)/prebuilt/dtb
endif
ifeq ($(GEN_RAMDISK_LZ4),true)
BOARD_RAMDISK_USE_LZ4 := true
endif
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOTIMG_HEADER_VERSION)

# ---- Partitions (real sizes only matter for building images, not for running TWRP) ----
BOARD_FLASH_BLOCK_SIZE := 262144
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 67108864
BOARD_HAS_LARGE_FILESYSTEM := true
BOARD_SYSTEMIMAGE_PARTITION_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_ODM := odm

# Dynamic partitions (Samsung: system/vendor/product/odm live inside "super")
BOARD_SUPER_PARTITION_SIZE := $(or $(GEN_SUPER_SIZE),6442450944)
BOARD_SUPER_PARTITION_GROUPS := samsung_dynamic_partitions
BOARD_SAMSUNG_DYNAMIC_PARTITIONS_PARTITION_LIST := system vendor product odm
BOARD_SAMSUNG_DYNAMIC_PARTITIONS_SIZE := $(shell expr $(BOARD_SUPER_PARTITION_SIZE) - 4194304)
BOARD_PARTITION_LIST := system vendor product odm
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := ext4

# ---- System-as-root, recovery partition exists (non A/B) ----
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery/root/system/etc/twrp.flags
BOARD_USES_METADATA_PARTITION := true

# ---- TWRP ----
TW_THEME := portrait_hdpi
TARGET_SCREEN_WIDTH := 720
TARGET_SCREEN_HEIGHT := 1600
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TW_DEFAULT_LANGUAGE := en
TW_EXTRA_LANGUAGES := true
TW_USE_TOOLBOX := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_HAS_DOWNLOAD_MODE := true
TW_NO_REBOOT_BOOTLOADER := true
TW_NO_SCREEN_BLANK := false
TW_INPUT_BLACKLIST := "hbtp_vm"
RECOVERY_SDCARD_ON_DATA := true
TARGET_USES_MKE2FS := true
TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel/brightness"
TW_MAX_BRIGHTNESS := 255
TW_DEFAULT_BRIGHTNESS := 120
TARGET_USES_LOGD := true
TW_INCLUDE_NTFS_3G := true
TW_INCLUDE_FUSE_EXFAT := true
TARGET_DISABLE_TRIPLE_BUFFERING := false

# Decryption is OFF for the first boot test (set CRYPTO=true in the workflow input to try it)
ifeq ($(CRYPTO),true)
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_INCLUDE_FBE_METADATA_DECRYPT := true
BOARD_USES_QCOM_FBE_DECRYPTION := false
PLATFORM_VERSION := 16.1.0
PLATFORM_SECURITY_PATCH := 2127-12-31
VENDOR_SECURITY_PATCH := 2127-12-31
endif

# Debug: keep logging on and SELinux permissive-friendly for bring-up
TWRP_INCLUDE_LOGCAT := true
TARGET_USES_LOGD := true
